<!DOCTYPE html>
<html>
  <head>
    <title>ProtospaceUserId</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="header">
      <div class="inner">
        <div class="nav">
          <div class="nav__left">
            <%= image_tag "logo.png", class: :logo %>
          </div>

          <div class="nav__right">

            <% if user_signed_in? %>

              <div class="greeting">
                こんにちは、
                <%= link_to current_user.name, user_path(current_user.id), class: :greeting__link %>
              </div>

              <%= link_to "New Proto", new_prototype_path, class: :nav__btn %>

              <%= link_to "ログアウト", destroy_user_session_path,
              data: { turbo_method: :delete }, class: :nav__logout %>

            <% else %>

              <%= link_to "ログイン", new_user_session_path, class: :nav__btn %>

              <%= link_to "新規登録", new_user_registration_path, class: :nav__btn %>

            <% end %>

          </div>
        </div>
      </div>
    </header>

    <%= yield %>

    <footer class="footer">
      <p class="copyright">
        Copyright © PROTO SPACE All rights reserved.
      </p>
    </footer>
  </body>
</html>
